<?xml version="1.0" encoding="utf-8"?>
<!-- Framework-dependent single-file publish: one small Balatron.exe that needs
     the .NET Desktop Runtime installed. If it is missing, Windows prompts the
     user with a download link on launch. RollForward (set in the csproj) lets
     it run on any newer runtime, not just 6.x. -->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net6.0-windows</TargetFramework>
    <PublishDir>bin\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>
