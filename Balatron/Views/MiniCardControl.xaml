<UserControl x:Class="Balatron.Views.MiniCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Balatron.Views"
             UseLayoutRounding="True">
    <Border x:Name="Frame"
            Width="87"
            Background="{StaticResource BalatroPanel}"
            CornerRadius="8"
            Padding="6,5"
            Margin="3"
            views:HoverPopup.Content="{Binding Tooltip}">
        <Border.Style>
            <!-- Border brush/thickness live here, not as local values, so the
                 "active" trigger can override them. -->
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{Binding Accent}" />
                <Setter Property="BorderThickness" Value="2" />
                <Style.Triggers>
                    <!-- "Active": this card has a predictable random outcome -->
                    <DataTrigger Binding="{Binding HasOutcome}" Value="True">
                        <Setter Property="BorderBrush" Value="#FFD966" />
                        <Setter Property="BorderThickness" Value="3" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#FFD966" BlurRadius="12" ShadowDepth="0" Opacity="0.65" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Text="{Binding Caption}"
                       FontSize="14"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#B8B6C1"
                       Margin="0,0,0,3">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Caption}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid x:Name="ArtGrid" views:PixelArt.Scale="1">
                <ItemsControl ItemsSource="{Binding MiniSpriteLayers}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMiniSprite}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border CornerRadius="6" Background="{Binding FaceBackground}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMiniSprite}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding FaceText}"
                               Foreground="{Binding FaceForeground}"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <!-- Rank + suit for playing cards -->
                <TextBlock Text="{Binding OverlayText}"
                           Foreground="{Binding OverlayForeground}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <!-- Destroyed cards get crossed out -->
                <Path Stroke="#E84C3D"
                      StrokeThickness="5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Stretch="Fill"
                      Margin="6"
                      Opacity="0.9"
                      Data="M 0,0 L 1,1 M 1,0 L 0,1">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDestroyed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
            <TextBlock Text="{Binding Name}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="38"
                       Margin="0,3,0,0"
                       Foreground="{StaticResource BalatroWhite}" />
            <TextBlock Text="{Binding Badges}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="#FFD966">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Badges}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Badges}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
