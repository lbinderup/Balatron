<Window x:Class="Balatron.Views.LivePeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Balatron.Views"
        Title="Live Peek"
        Height="700"
        Width="720"
        UseLayoutRounding="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        MinHeight="320"
        ResizeMode="CanResize">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/Balatron;component/Resources/app_icon.ico" />
    </Window.Icon>
    <Window.Resources>
        <!-- Grips living in the window's transparent margin, since the system
             resize border can't be reached through it.
             The fill is #01... rather than Transparent on purpose: this is a
             layered window, so Windows hit-tests by pixel alpha and a fully
             transparent grip would be clicked straight through. -->
        <Style x:Key="ResizeGrip" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="#01000000" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
    <Border Margin="12"
            Background="{StaticResource BalatroDark}"
            BorderBrush="{StaticResource BalatroShadow}"
            BorderThickness="3"
            CornerRadius="18">
        <Grid TextElement.Foreground="{StaticResource BalatroWhite}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource BalatroPanel}"
                    CornerRadius="15,15,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot"
                         Width="12"
                         Height="12"
                         Margin="16,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource BalatroRed}" />
                <TextBlock Grid.Column="1"
                           Text="Live Peek"
                           VerticalAlignment="Center"
                           FontSize="18" />
                <Button Grid.Column="2"
                        Content="—" Padding="0"
                        Width="36"
                        Height="28"
                        Margin="0,8,8,8"
                        Background="{StaticResource BalatroBlue}"
                        Click="MinimizeButton_Click" />
                <Button Grid.Column="3"
                        Content="X" Padding="0"
                        Width="36"
                        Height="28"
                        Margin="0,8,12,8"
                        Background="{StaticResource BalatroRed}"
                        Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource BalatroPanel}"
                    CornerRadius="8"
                    Margin="12,10,12,0"
                    Padding="10,6">
                <StackPanel>
                    <TextBlock x:Name="HeaderText"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Text="Waiting for a Balatro save…" />
                    <TextBlock x:Name="StatusText"
                               FontSize="14"
                               Foreground="#B8B6C1"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2"
                          Margin="12,8,12,12"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Your jokers &amp; consumables"
                               FontSize="18"
                               Margin="4,6,0,2"
                               Foreground="#FFD966" />
                    <TextBlock x:Name="OwnedEmptyText"
                               FontSize="14"
                               Foreground="#B8B6C1"
                               Margin="4,0,0,4"
                               Text="Nothing owned yet." />
                    <ItemsControl x:Name="OwnedList" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:MiniCardControl />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Tags on the left, vouchers pinned right -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Tags this ante"
                                   FontSize="18"
                                   Margin="4,0,0,2"
                                   Foreground="#FFD966" />
                        <TextBlock x:Name="VouchersHeader"
                                   Grid.Column="1"
                                   Visibility="Collapsed"
                                   Text="Vouchers"
                                   FontSize="18"
                                   Margin="8,0,4,2"
                                   Foreground="#FFD966" />

                        <StackPanel Grid.Row="1">
                            <TextBlock x:Name="TagsEmptyText"
                                       FontSize="14"
                                       Foreground="#B8B6C1"
                                       Margin="4,0,0,4"
                                       Text="No tags offered." />
                            <ItemsControl x:Name="TagsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <views:MiniCardControl />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border x:Name="VoucherPanel"
                                Grid.Row="1"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="{StaticResource BalatroPanel}"
                                BorderBrush="{StaticResource BalatroShadow}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Margin="4"
                                Padding="4"
                                VerticalAlignment="Top">
                            <ItemsControl x:Name="VoucherLinesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <views:MiniCardControl />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>

                    <TextBlock Text="Shop right now"
                               FontSize="18"
                               Margin="4,10,0,2"
                               Foreground="#FFD966" />
                    <TextBlock x:Name="ShopEmptyText"
                               FontSize="14"
                               Foreground="#B8B6C1"
                               Margin="4,0,0,4"
                               Text="No shop cards in the current save." />
                    <ItemsControl x:Name="ShopNowList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:PeekCardControl />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Packs on offer"
                               FontSize="18"
                               Margin="4,12,0,2"
                               Foreground="#FFD966" />
                    <TextBlock x:Name="PacksEmptyText"
                               FontSize="14"
                               Foreground="#B8B6C1"
                               Margin="4,0,0,4"
                               Text="No packs offered right now." />
                    <ItemsControl x:Name="PacksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BalatroPanel}"
                                        BorderBrush="{StaticResource BalatroShadow}"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        Padding="10,6"
                                        Margin="4"
                                        views:HoverPopup.Content="{Binding Tooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Sprite}"
                                               Height="47.5"
                                               Margin="0,0,10,0"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="16" />
                                            <TextBlock Text="{Binding ChoiceLabel}"
                                                       FontSize="14"
                                                       Foreground="#B8B6C1" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Peek inside"
                                                FontSize="14"
                                                Padding="14,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding PeekCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NextPacksText"
                               FontSize="14"
                               Foreground="#B8B6C1"
                               Margin="4,2,0,0"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,12,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Upcoming rerolls"
                                   FontSize="18"
                                   Margin="4,0,0,0"
                                   Foreground="#FFD966" />
                        <Button Grid.Column="1"
                                Content="+3 more"
                                FontSize="14"
                                Padding="8,2"
                                Margin="0,0,4,0"
                                Click="MoreRerollsButton_Click" />
                    </Grid>
                    <ItemsControl x:Name="RerollsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,4">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               Margin="4,0,0,0"
                                               Foreground="#B8B6C1" />
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <views:MiniCardControl />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>

        <Thumb Style="{StaticResource ResizeGrip}" Tag="L" Cursor="SizeWE"
               HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="12" Margin="0,12"
               DragDelta="ResizeThumb_DragDelta" />
        <Thumb Style="{StaticResource ResizeGrip}" Tag="R" Cursor="SizeWE"
               HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="12" Margin="0,12"
               DragDelta="ResizeThumb_DragDelta" />
        <Thumb Style="{StaticResource ResizeGrip}" Tag="T" Cursor="SizeNS"
               VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="12" Margin="12,0"
               DragDelta="ResizeThumb_DragDelta" />
        <Thumb Style="{StaticResource ResizeGrip}" Tag="B" Cursor="SizeNS"
               VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="12" Margin="12,0"
               DragDelta="ResizeThumb_DragDelta" />
        <Thumb Style="{StaticResource ResizeGrip}" Tag="TL" Cursor="SizeNWSE"
               HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14"
               DragDelta="ResizeThumb_DragDelta" />
        <Thumb Style="{StaticResource ResizeGrip}" Tag="TR" Cursor="SizeNESW"
               HorizontalAlignment="Right" VerticalAlignment="Top" Width="14" Height="14"
               DragDelta="ResizeThumb_DragDelta" />
        <Thumb Style="{StaticResource ResizeGrip}" Tag="BL" Cursor="SizeNESW"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="14" Height="14"
               DragDelta="ResizeThumb_DragDelta" />
        <Thumb Style="{StaticResource ResizeGrip}" Tag="BR" Cursor="SizeNWSE"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14"
               DragDelta="ResizeThumb_DragDelta" />
    </Grid>
</Window>
