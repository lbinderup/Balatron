<Window x:Class="Balatron.Views.LivePeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Balatron.Views"
        Title="Live Peek"
        Height="700"
        Width="720"
        UseLayoutRounding="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResize">
    <Window.Icon>
        <BitmapImage UriSource="pack://application:,,,/Balatron;component/Resources/app_icon.ico" />
    </Window.Icon>
    <Border Margin="12"
            Background="{StaticResource BalatroDark}"
            BorderBrush="{StaticResource BalatroShadow}"
            BorderThickness="3"
            CornerRadius="18">
        <Grid TextElement.Foreground="{StaticResource BalatroWhite}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource BalatroPanel}"
                    CornerRadius="15,15,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot"
                         Width="12"
                         Height="12"
                         Margin="16,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource BalatroRed}" />
                <TextBlock Grid.Column="1"
                           Text="Live Peek"
                           VerticalAlignment="Center"
                           FontSize="18" />
                <Button Grid.Column="2"
                        Content="—" Padding="0"
                        Width="36"
                        Height="28"
                        Margin="0,8,8,8"
                        Background="{StaticResource BalatroBlue}"
                        Click="MinimizeButton_Click" />
                <Button Grid.Column="3"
                        Content="X" Padding="0"
                        Width="36"
                        Height="28"
                        Margin="0,8,12,8"
                        Background="{StaticResource BalatroRed}"
                        Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource BalatroPanel}"
                    CornerRadius="8"
                    Margin="12,10,12,0"
                    Padding="10,6">
                <StackPanel>
                    <TextBlock x:Name="HeaderText"
                               FontSize="16"
                               TextWrapping="Wrap"
                               Text="Waiting for a Balatro save…" />
                    <TextBlock x:Name="StatusText"
                               FontSize="14"
                               Foreground="#B8B6C1"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2"
                          Margin="12,8,12,12"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Your jokers &amp; consumables"
                               FontSize="18"
                               Margin="4,6,0,2"
                               Foreground="#FFD966" />
                    <TextBlock x:Name="OwnedEmptyText"
                               FontSize="14"
                               Foreground="#B8B6C1"
                               Margin="4,0,0,4"
                               Text="Nothing owned yet." />
                    <ItemsControl x:Name="OwnedList" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:MiniCardControl />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Shop right now"
                               FontSize="18"
                               Margin="4,6,0,2"
                               Foreground="#FFD966" />
                    <TextBlock x:Name="ShopEmptyText"
                               FontSize="14"
                               Foreground="#B8B6C1"
                               Margin="4,0,0,4"
                               Text="No shop cards in the current save." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl x:Name="ShopNowList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:PeekCardControl />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="VoucherPanel"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Background="{StaticResource BalatroPanel}"
                                BorderBrush="{StaticResource BalatroShadow}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Margin="4"
                                Padding="8,6"
                                VerticalAlignment="Top">
                            <ItemsControl x:Name="VoucherLinesList" Width="150">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2,0,6"
                                                    ToolTip="{Binding Tooltip}"
                                                    ToolTipService.InitialShowDelay="200"
                                                    ToolTipService.ShowDuration="30000">
                                            <TextBlock Text="{Binding Header}"
                                                       FontSize="14"
                                                       Foreground="#B8B6C1" />
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Sprite}"
                                                       Height="47.5"
                                                       Margin="0,2,6,0"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="16"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="94"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource BalatroWhite}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Grid>

                    <TextBlock Text="Packs on offer"
                               FontSize="18"
                               Margin="4,12,0,2"
                               Foreground="#FFD966" />
                    <TextBlock x:Name="PacksEmptyText"
                               FontSize="14"
                               Foreground="#B8B6C1"
                               Margin="4,0,0,4"
                               Text="No packs offered right now." />
                    <ItemsControl x:Name="PacksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BalatroPanel}"
                                        BorderBrush="{StaticResource BalatroShadow}"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        Padding="10,6"
                                        Margin="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Sprite}"
                                               Height="47.5"
                                               Margin="0,0,10,0"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="16" />
                                            <TextBlock Text="{Binding ChoiceLabel}"
                                                       FontSize="14"
                                                       Foreground="#B8B6C1" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Peek inside"
                                                FontSize="14"
                                                Padding="14,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding PeekCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NextPacksText"
                               FontSize="14"
                               Foreground="#B8B6C1"
                               Margin="4,2,0,0"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,12,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Upcoming rerolls"
                                   FontSize="18"
                                   Margin="4,0,0,0"
                                   Foreground="#FFD966" />
                        <Button Grid.Column="1"
                                Content="+3 more"
                                FontSize="14"
                                Padding="8,2"
                                Margin="0,0,4,0"
                                Click="MoreRerollsButton_Click" />
                    </Grid>
                    <ItemsControl x:Name="RerollsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2,0,4">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               Margin="4,0,0,0"
                                               Foreground="#B8B6C1" />
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <views:PeekCardControl />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
